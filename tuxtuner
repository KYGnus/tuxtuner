                ;;

            4)
                enterprise_all
                tui_message "Enterprise" "Enterprise optimization completed."
                ;;

            5)
                enterprise_security
                tui_message "Security" "Security hardening completed."
                ;;

            6)
                enterprise_kernel
                tui_message "Kernel" "Kernel tuning completed."
                ;;

            7)
                enterprise_services
                tui_message "Services" "Service analysis completed."
                ;;

            8)
                opt_embedded
                tui_message "Embedded" "Embedded optimization completed."
                ;;

            9)
                show_system_info
                pause_screen
                ;;

            10)
                show_status
                pause_screen
                ;;

