TUI_BACKTITLE="$TUI_TITLE"

tui_message() {

    local title="$1"
    local message="$2"

    if command_exists dialog; then

        dialog \
            --backtitle "$TUI_BACKTITLE" \
            --title "$title" \
            --msgbox "$message" \
            15 70

    else

        echo
        echo "=== ${title} ==="
        echo
        echo "$message"
        echo
        pause_screen

    fi
}

tui_main_menu() {

    while true; do

        if ! command_exists dialog; then
            tui_terminal_menu
            return
        fi

        local choice

        choice=$(
            dialog \
                --clear \
                --backtitle "$TUI_BACKTITLE" \
                --title "Main Menu" \
                --menu "Select operation:" \
                22 78 13 \
                1 "Desktop Optimization" \
                2 "Server Optimization" \
                3 "Storage Optimization" \
                4 "Enterprise Optimization" \
                5 "Security Hardening" \
                6 "Kernel Tuning" \
                7 "Service Analysis" \
                8 "Embedded Optimization" \
                9 "System Information" \
                10 "System Status" \
                11 "View Log" \
                12 "Available Switches" \
