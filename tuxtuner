                        --backtitle "$TUI_BACKTITLE" \
                        --title "TuxTuner Log" \
                        --textbox "$LOG_FILE" \
                        30 100

                else

                    tui_message "Log" "Log file does not exist."

                fi

                ;;

            12)
                tui_message "Switches" "$(list_actions)"
                ;;

            0)
                break
                ;;

        esac

    done
}

