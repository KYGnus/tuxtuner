# =============================================================================
# ARGUMENT PARSER
# =============================================================================

parse_args() {

    while [[ $# -gt 0 ]]; do

        case "$1" in

            --help|-h)
                list_actions
                exit 0
                ;;

            --version|-V)
                echo "${APP_NAME} v${VERSION}"
                exit 0
                ;;

            --info)
                ACTION_INFO=1
                INTERACTIVE=0
                ;;

            --status)
                ACTION_STATUS=1
                INTERACTIVE=0
                ;;

            --list)
                list_actions
                exit 0
                ;;

            --desktop)
                PROFILE_DESKTOP=1
                INTERACTIVE=0
                ;;

            --server)
                PROFILE_SERVER=1
                INTERACTIVE=0
                ;;

            --embedded)
                PROFILE_EMBEDDED=1
                INTERACTIVE=0
                ;;

            --storage)
                OPT_STORAGE=1
                INTERACTIVE=0
                ;;

            --mediaserver|--media-server)
                OPT_MEDIA=1
                INTERACTIVE=0
                ;;

            --storageserver|--storage-server)
                OPT_STORAGE_SERVER=1
                INTERACTIVE=0
                ;;

            --idsips|--ids-ips)
                OPT_IDSIPS=1
                INTERACTIVE=0
                ;;

            --enterprise-kernel)
                ENTERPRISE_KERNEL=1
                INTERACTIVE=0
                ;;

            --enterprise-services)
                ENTERPRISE_SERVICES=1
                INTERACTIVE=0
                ;;

            --enterprise-security)
                ENTERPRISE_SECURITY=1
                INTERACTIVE=0
                ;;

            --enterprise-all)

                ENTERPRISE_KERNEL=1
                ENTERPRISE_SERVICES=1
                ENTERPRISE_SECURITY=1

                INTERACTIVE=0
                ;;

            --dry-run)
                DRY_RUN=1
                ;;

            --yes|-y)
                ASSUME_YES=1
                ;;

            --no-backup)
                BACKUP_ENABLED=0
                ;;

            --)
                shift
                break
                ;;

            -*)

                echo
                log_error "Unknown option: $1"
                echo "Use --help."
                exit 2
                ;;

            *)

                log_error "Unexpected argument: $1"
                exit 2
                ;;

        esac

        shift

    done
}

# =============================================================================
# CONFIRMATION
# =============================================================================

confirm_changes() {

    [[ "$DRY_RUN" -eq 1 ]] && return 0
    [[ "$ASSUME_YES" -eq 1 ]] && return 0

    echo
    echo "============================================================"
    echo " WARNING"
    echo "============================================================"
    echo
    echo "TuxTuner will modify system configuration."
    echo
    echo "Distribution : ${DISTRO_PRETTY}"
    echo "Kernel       : $(uname -r)"
    echo
    echo "Backups      : ${BACKUP_ENABLED}"
    echo

    printf "Continue? [y/N]: "

    local answer
    read -r answer

    case "$answer" in

        y|Y|yes|YES)
            return 0
            ;;

        *)
            log_warning "Operation cancelled."
            return 1
            ;;

    esac
}

# =============================================================================
# MAIN
# =============================================================================

main() {

    parse_args "$@"

    # -------------------------------------------------------------------------
    # Information-only operations
    # -------------------------------------------------------------------------

    if [[ "$ACTION_INFO" -eq 1 ]] ||
       [[ "$ACTION_STATUS" -eq 1 ]]; then

        detect_distro

        [[ "$ACTION_INFO" -eq 1 ]] && show_system_info
        [[ "$ACTION_STATUS" -eq 1 ]] && show_status

        exit 0
    fi

    # -------------------------------------------------------------------------
    # Everything else requires root
    # -------------------------------------------------------------------------

    require_root

    init_logging
    init_temp
    detect_distro

    mkdir -p "$STATE_DIR"

    if [[ "$BACKUP_ENABLED" -eq 1 ]]; then
        mkdir -p "$BACKUP_DIR"
    fi

    echo

    log_info "${APP_NAME} v${VERSION}"
    log_info "Terminal-based Linux optimization framework."

    if [[ "$DRY_RUN" -eq 1 ]]; then
        log_warning "DRY-RUN MODE ENABLED"
        log_warning "No system changes will be performed."
    fi

    # -------------------------------------------------------------------------
    # Interactive
    # -------------------------------------------------------------------------

    if [[ "$INTERACTIVE" -eq 1 ]]; then

        tui_main_menu

    # -------------------------------------------------------------------------
    # CLI
    # -------------------------------------------------------------------------

    else

        if ! confirm_changes; then
            exit 1
        fi

        run_cli

    fi

    echo
    log_success "TuxTuner completed."
    log_info "Log: ${LOG_FILE}"

    if [[ "$BACKUP_ENABLED" -eq 1 ]]; then
        log_info "Backups: ${BACKUP_DIR}"
    fi
}

# =============================================================================
# START
# =============================================================================

main "$@"
