# =============================================================================
# CLI EXECUTION
# =============================================================================

run_cli() {

    local executed=0

    if [[ "$ACTION_INFO" -eq 1 ]]; then
        show_system_info
        executed=1
    fi

    if [[ "$ACTION_STATUS" -eq 1 ]]; then
        show_status
        executed=1
    fi

    if [[ "$PROFILE_DESKTOP" -eq 1 ]]; then
        opt_desktop
        executed=1
    fi

    if [[ "$PROFILE_SERVER" -eq 1 ]]; then
        opt_server
        executed=1
    fi

    if [[ "$PROFILE_EMBEDDED" -eq 1 ]]; then
        opt_embedded
        executed=1
    fi

    if [[ "$OPT_STORAGE" -eq 1 ]]; then
        opt_storage
        executed=1
    fi

    if [[ "$OPT_MEDIA" -eq 1 ]]; then
        opt_media
        executed=1
    fi

    if [[ "$OPT_STORAGE_SERVER" -eq 1 ]]; then
        opt_storage_server
        executed=1
    fi

    if [[ "$OPT_IDSIPS" -eq 1 ]]; then
        opt_idsips
        executed=1
    fi

    if [[ "$ENTERPRISE_KERNEL" -eq 1 ]]; then
        enterprise_kernel
        executed=1
    fi

    if [[ "$ENTERPRISE_SERVICES" -eq 1 ]]; then
        enterprise_services
        executed=1
    fi

    if [[ "$ENTERPRISE_SECURITY" -eq 1 ]]; then
        enterprise_security
        executed=1
    fi

    if [[ "$ENTERPRISE_KERNEL" -eq 1 ]] &&
       [[ "$ENTERPRISE_SERVICES" -eq 1 ]] &&
       [[ "$ENTERPRISE_SECURITY" -eq 1 ]]; then

        :
    fi

    if [[ "$executed" -eq 0 ]]; then
        log_error "No action selected."
        return 1
    fi

    return 0
}

# =============================================================================
# TUI
